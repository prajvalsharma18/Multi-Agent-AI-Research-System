# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5.6-luna
# Optional: only tried if the primary model returns 404
OPENAI_FALLBACK_MODEL=
# Number of retries for transient errors (default: 2)
OPENAI_MAX_RETRIES=2
# Request timeout in seconds (default: 60)
OPENAI_REQUEST_TIMEOUT=60

# Tavily Search (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key

# Critic score at/above this skips Revision (default: 8)
REVISION_SCORE_THRESHOLD=8

# Max URLs to scrape per run (default: 3)
MAX_URLS_TO_SCRAPE=3

# Max characters per scraped page (default: 3000)
MAX_SCRAPE_CHARS=3000

# Max chars of reader summary sent to Writer (saves TPM)
MAX_WRITER_INPUT_CHARS=7000

# Cap agent tool-calling loops (default: 3)
AGENT_RECURSION_LIMIT=3

# Enable file-based stage + checkpoint caching (default: true)
PIPELINE_CACHE_ENABLED=true
